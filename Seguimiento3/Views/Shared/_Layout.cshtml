<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Seguimiento3</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Seguimiento3.styles.css" asp-append-version="true" />
</head>

<body>
    <nav class="navbar navbar-expand-lg nav-principal">
        <div class="container-fluid">
            <a class="navbar-brand texto-nav" href="#">Sabor Envigado</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link texto-nav" href="#">Inicio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link texto-nav" href="#quienes-somos">¿Quiénes somos?</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link texto-nav" href="#restaurantes">Restaurantes</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link texto-nav" href="#explora">Explora</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link texto-nav" href="#invitados">Invitados</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link texto-nav" href="#programacion">Programación</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link texto-nav" href="#registro-y-reserva">Registro y reserva</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <div>
        @RenderBody()
    </div>

    <footer>
        <h5 class="fs-6 mb-2 fw-normal">Copyright &copy; 2026 Sabor Envigado - Festival Gastronómico. Todos los derechos
            reservados.</h5>
        <h6 class="fs-6 fst-italic m-0">Desarrollador por Esteban Pérez Garzón</h6>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
