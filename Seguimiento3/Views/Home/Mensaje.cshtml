@model Seguimiento3.Models.Asistente

<header class="encabezado-principal">
    <h1>¡Reserva confirmada!</h1>
    <p>Del 20 al 23 de Noviembre de 2023 · Sabor Envigado</p>
</header>

<main class="container contenido">
    <section id="confirmacion-registro">
        <h1 class="titulo-registro">Hola, @Model.NombreCompleto</h1>

        <p>
            🍝 ¡Gracias por registrarte! Tu cupo para el Festival Gastronómico Sabor Envigado 2026
            quedó reservado con los siguientes datos:
        </p>

        <div class="row mt-3">
            <div class="col-sm-2 fw-bold">Nombre completo:</div>
            <div class="col-sm-10">@Model.NombreCompleto</div>
        </div>

        <div class="row mt-3">
            <div class="col-sm-2 fw-bold">Correo electrónico:</div>
            <div class="col-sm-10">@Model.CorreoElectronico</div>
        </div>

        <div class="row mt-3">
            <div class="col-sm-2 fw-bold">Teléfono:</div>
            <div class="col-sm-10">@Model.Telefono</div>
        </div>

        <div class="row mt-3">
            <div class="col-sm-2 fw-bold">Tipo de asistente:</div>
            <div class="col-sm-10">@Model.TipoAsistente</div>
        </div>

        <div class="row mt-3">
            <div class="col-sm-2 fw-bold">Taller / Experiencia:</div>
            <div class="col-sm-10">
                <ul class="mb-0">
                    @foreach (var taller in Model.Taller)
                    {
                        <li>@taller</li>
                    }
                </ul>
            </div>
        </div>

        <div class="alert alert-success mt-4 text-center">
            ¡Te esperamos del 20 al 23 de noviembre para vivir una experiencia llena de sabor!
        </div>

        <div class="d-flex justify-content-center">
            <a asp-controller="Home" asp-action="Index" class="btn btn-success mt-3">Volver al inicio</a>
        </div>
    </section>
</main>