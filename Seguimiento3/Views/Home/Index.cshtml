    <section id="registro-y-reserva">
        <h1 class="titulo-registro">Registro de asistentes y reserva de cupos</h1>

        <p>🍝 ¡El plan más delicioso del año te espera! Completa el formulario y asegura tu cupo para el Festival
            Gastronómico Sabor Envigado 2026. ¡No te quedes sin vivir esta experiencia llena de sabor!
        </p>

        <form id="formularioReserva">
            <div class="row mt-3">
                <label for="NombreCompleto" class="col-sm-2 col-form-label">Nombre completo:</label>
                <div class="col-sm-10">
                    <input type="text" class="form-control" id="NombreCompleto" placeholder="Esteban Pérez Garzón"
                           name="NombreCompleto" required>
                </div>
            </div>



            <div class="row mt-3">
                <label for="CorreoElectronico" class="col-sm-2 col-form-label">Correo electrónico:</label>
                <div class="col-sm-10">
                    <input type="email" class="form-control" id="CorreoElectronico" placeholder="Usuario@ejemplo.com"
                           name="CorreoElectronico" required>
                </div>
            </div>



            <div class="row mt-3">
                <label for="Telefono" class="col-sm-2 col-form-label">Teléfono:</label>
                <div class="col-sm-10">
                    <input type="number" class="form-control" id="Telefono" placeholder="3001234567" name="Telefono"
                           required>
                </div>
            </div>



            <fieldset class="row mt-3">
                <legend class="col-form-label col-sm-2 pt-0">Tipo de asistente:</legend>
                <div class="col-sm-10">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="TipoAsistente" id="general" value="General"
                               required>
                        <label class="form-check-label" for="general">
                            General
                        </label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="TipoAsistente" id="estudiante"
                               value="Estudiante" required>
                        <label class="form-check-label" for="estudiante">
                            Estudiante
                        </label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="TipoAsistente" id="prensa" value="Prensa"
                               required>
                        <label class="form-check-label" for="prensa">
                            Prensa
                        </label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="TipoAsistente" id="otro" value="Otro"
                               required>
                        <label class="form-check-label" for="otro">
                            Otro
                        </label>
                    </div>
                </div>
            </fieldset>



            <fieldset class="row mt-3">
                <legend class="col-form-label col-sm-2 pt-0">Taller / Experiencia:</legend>
                <div class="col-sm-10">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox"
                               value="Secretos de la Arepa de Chócolo Tradicional" id="ArepaDeChocolo" name="Taller">
                        <label class="form-check-label" for="ArepaDeChocolo">
                            Secretos de la Arepa de Chócolo Tradicional
                        </label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" value="Cerveza Artesanal y Maridaje Local"
                               id="CervezaArtesanal" name="Taller">
                        <label class="form-check-label" for="CervezaArtesanal">
                            Cerveza Artesanal y Maridaje Local
                        </label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox"
                               value="Coctelería de Autor con Frutas Antioqueñas" id="CocteleriaFrutas" name="Taller">
                        <label class="form-check-label" for="CocteleriaFrutas">
                            Coctelería de Autor con Frutas Antioqueñas
                        </label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox"
                               value="Secretos del Chicharrón Crujiente Antioqueño" id="ChicharronAntioqueño"
                               name="Taller">
                        <label class="form-check-label" for="ChicharronAntioqueño">
                            Secretos del Chicharrón Crujiente Antioqueño
                        </label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" value="Repostería y Sabores de la Montaña"
                               id="Reposteria" name="Taller">
                        <label class="form-check-label" for="Reposteria">
                            Repostería y Sabores de la Montaña
                        </label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox"
                               value="Muestra de Cocina Tradicional Abierta al Público" id="CocinaTradicional"
                               name="Taller">
                        <label class="form-check-label" for="CocinaTradicional">
                            Muestra de Cocina Tradicional Abierta al Público
                        </label>
                    </div>
                </div>
            </fieldset>



            <div class="d-flex justify-content-center">
